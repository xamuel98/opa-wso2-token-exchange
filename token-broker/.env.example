# Listen port for the local token broker
PORT=8787

# WSO2 Identity Server token endpoint
WSO2_TOKEN_URL=https://wso2.local:9443/oauth2/token

# WSO2 Identity Server UserInfo endpoint (enriches /authz/decision subject)
WSO2_USERINFO_URL=https://wso2.local:9443/oauth2/userinfo

# Standard Application credentials (server-side only — never expose to the browser)
WSO2_STD_CLIENT_ID=<standard_app_client_id>
WSO2_STD_CLIENT_SECRET=<standard_app_client_secret>

# Scopes requested during token exchange
TOKEN_EXCHANGE_SCOPE=openid profile email

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local OPA decision endpoint (localhost only — do not point at a public OPA)
OPA_DECISION_URL=http://127.0.0.1:8181/v1/data/fortis/authz/decision

# UNSAFE — local self-signed certificate testing ONLY.
# Do NOT set this in production. Prefer installing a trusted CA instead.
# NODE_TLS_REJECT_UNAUTHORIZED=0
